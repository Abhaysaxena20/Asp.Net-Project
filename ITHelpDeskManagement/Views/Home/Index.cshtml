@model ITHelpDeskManagement.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var currentEmail = User.FindFirst(
        System.Security.Claims.ClaimTypes.Email)?.Value
        ?? User.Identity?.Name
        ?? "User";

    var currentRole = User.IsInRole("Admin")
        ? "Administrator"
        : User.IsInRole("SupportStaff")
            ? "Support Staff"
            : "User";
}

<div class="dashboard-page">

    <!-- Welcome Section -->
    <div class="dashboard-welcome mb-4">

        <div>
            <span class="text-primary fw-bold small">
                <i class="bi bi-grid-fill me-2"></i>
                OVERVIEW
            </span>

            <h2 class="fw-bold mt-3">
                Welcome back!
            </h2>

            <p class="text-muted">
                You are logged in as
                <strong>@currentEmail</strong>
                <span class="badge bg-primary ms-2">
                    @currentRole
                </span>
            </p>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("User"))
        {
            <a asp-controller="Ticket"
               asp-action="Create"
               class="btn btn-primary raise-ticket-btn">

                <i class="bi bi-plus-lg me-2"></i>
                Raise New Ticket
            </a>
        }

    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <!-- Total Tickets -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-stat-card">

                <div class="stat-top">
                    <div>
                        <span class="stat-label">Total Tickets</span>
                        <h2>@Model.TotalTickets</h2>
                        <span class="stat-description">
                            <i class="bi bi-collection me-1"></i>
                            All support requests
                        </span>
                    </div>

                    <div class="stat-icon stat-blue">
                        <i class="bi bi-ticket-perforated"></i>
                    </div>
                </div>

                <div class="stat-bottom stat-blue-line"></div>

            </div>
        </div>

        <!-- Open Tickets -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-stat-card">

                <div class="stat-top">
                    <div>
                        <span class="stat-label">Open Tickets</span>
                        <h2>@Model.OpenTickets</h2>
                        <span class="stat-description">
                            <i class="bi bi-folder2-open me-1"></i>
                            Awaiting attention
                        </span>
                    </div>

                    <div class="stat-icon stat-orange">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                </div>

                <div class="stat-bottom stat-orange-line"></div>

            </div>
        </div>

        <!-- In Progress -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-stat-card">

                <div class="stat-top">
                    <div>
                        <span class="stat-label">In Progress</span>
                        <h2>@Model.InProgressTickets</h2>
                        <span class="stat-description">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            Currently being handled
                        </span>
                    </div>

                    <div class="stat-icon stat-purple">
                        <i class="bi bi-gear"></i>
                    </div>
                </div>

                <div class="stat-bottom stat-purple-line"></div>

            </div>
        </div>

        <!-- Resolved -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-stat-card">

                <div class="stat-top">
                    <div>
                        <span class="stat-label">Resolved Tickets</span>
                        <h2>@Model.ResolvedTickets</h2>
                        <span class="stat-description">
                            <i class="bi bi-check-circle me-1"></i>
                            Successfully completed
                        </span>
                    </div>

                    <div class="stat-icon stat-green">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>

                <div class="stat-bottom stat-green-line"></div>

            </div>
        </div>

    </div>

    <!-- Recent Tickets -->
    <div class="dashboard-table-card">

        <div class="dashboard-table-header">

            <div>
                <h5>
                    <i class="bi bi-clock-history me-2"></i>
                    Recent Tickets
                </h5>

                <p>Latest IT support requests submitted to the system.</p>
            </div>

            <a asp-controller="Ticket"
               asp-action="Index"
               class="view-all-btn">

                View All Tickets
                <i class="bi bi-arrow-right ms-1"></i>
            </a>

        </div>

        <div class="table-responsive">

            <table class="table dashboard-table mb-0">

                <thead>
                    <tr>
                        <th class="ps-4">Ticket ID</th>
                        <th>Ticket Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.RecentTickets != null &&
                         Model.RecentTickets.Any())
                    {
                        @foreach (var ticket in Model.RecentTickets)
                        {
                            var priorityClass = ticket.Priority switch
                            {
                                "High" => "priority-high",
                                "Medium" => "priority-medium",
                                "Low" => "priority-low",
                                _ => "priority-default"
                            };

                            var statusClass = ticket.Status switch
                            {
                                "Open" => "status-open",
                                "In Progress" => "status-progress",
                                "Resolved" => "status-resolved",
                                "Closed" => "status-closed",
                                _ => "status-default"
                            };

                            <tr>

                                <td class="ps-4">
                                    <span class="ticket-number">
                                        #@ticket.TicketId
                                    </span>
                                </td>

                                <td>
                                    <span class="ticket-title">
                                        @ticket.Title
                                    </span>
                                </td>

                                <td>
                                    <span class="ticket-badge @priorityClass">
                                        @ticket.Priority
                                    </span>
                                </td>

                                <td>
                                    <span class="ticket-badge @statusClass">
                                        <span class="badge-dot"></span>
                                        @ticket.Status
                                    </span>
                                </td>

                                <td>
                                    <span class="ticket-date">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @ticket.CreatedAt.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Ticket"
                                       asp-action="Details"
                                       asp-route-id="@ticket.TicketId"
                                       class="ticket-view-btn"
                                       title="View ticket details">

                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">

                                <div class="dashboard-empty-state">

                                    <div class="empty-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>

                                    <h6>No tickets found</h6>

                                    <p>
                                        There are currently no tickets to display.
                                    </p>

                                    @if (User.IsInRole("Admin") ||
                                         User.IsInRole("User"))
                                    {
                                        <a asp-controller="Ticket"
                                           asp-action="Create"
                                           class="btn btn-primary btn-sm">
                                            <i class="bi bi-plus-lg me-1"></i>
                                            Create First Ticket
                                        </a>
                                    }

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="dashboard-table-footer">
            <span>
                Showing latest
                <strong>@(Model.RecentTickets?.Count() ?? 0)</strong>
                tickets
            </span>

            <a asp-controller="Ticket" asp-action="Index">
                Explore all tickets
                <i class="bi bi-arrow-up-right ms-1"></i>
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <style>
        .dashboard-welcome {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .welcome-label {
            color: #4263eb;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            margin-bottom: 9px;
        }

        .dashboard-welcome h2 {
            font-size: 27px;
            font-weight: 750;
            color: #172b4d;
            margin-bottom: 7px;
        }

        .dashboard-welcome p {
            color: #667085;
            font-size: 13px;
            margin-bottom: 0;
        }

        .raise-ticket-btn {
            padding: 11px 18px;
            font-size: 12px;
            box-shadow: 0 4px 10px rgba(66, 99, 235, .18);
        }

        /* Statistics cards */

        .dashboard-stat-card {
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 14px;
            padding: 22px 21px 0;
            height: 100%;
            overflow: hidden;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .dashboard-stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 9px 24px rgba(16, 24, 40, .07);
            }

        .stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding-bottom: 20px;
        }

        .stat-label {
            color: #667085;
            font-size: 12px;
            font-weight: 600;
        }

        .stat-top h2 {
            font-size: 30px;
            font-weight: 750;
            color: #172b4d;
            margin: 11px 0 7px;
        }

        .stat-description {
            color: #98a2b3;
            font-size: 10px;
        }

        .stat-icon {
            width: 49px;
            height: 49px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            font-size: 23px;
            flex-shrink: 0;
        }

        .stat-blue {
            background: #eef2ff;
            color: #4263eb;
        }

        .stat-orange {
            background: #fff4e5;
            color: #ed9417;
        }

        .stat-purple {
            background: #f3edff;
            color: #8b5cf6;
        }

        .stat-green {
            background: #e8f8ef;
            color: #16a36a;
        }

        .stat-bottom {
            height: 3px;
            margin: 0 -21px;
        }

        .stat-blue-line {
            background: #4263eb;
        }

        .stat-orange-line {
            background: #ed9417;
        }

        .stat-purple-line {
            background: #8b5cf6;
        }

        .stat-green-line {
            background: #16a36a;
        }

        /* Recent tickets */

        .dashboard-table-card {
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(16, 24, 40, .035);
        }

        .dashboard-table-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
            padding: 23px 25px;
            border-bottom: 1px solid #edf0f5;
        }

            .dashboard-table-header h5 {
                font-size: 16px;
                font-weight: 700;
                color: #172b4d;
                margin-bottom: 5px;
            }

                .dashboard-table-header h5 i {
                    color: #4263eb;
                }

            .dashboard-table-header p {
                color: #98a2b3;
                font-size: 11px;
                margin: 0;
            }

        .view-all-btn {
            text-decoration: none;
            color: #4263eb;
            background: #eef2ff;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 600;
            transition: all .2s;
        }

            .view-all-btn:hover {
                background: #dfe7ff;
                color: #3455d1;
            }

        .dashboard-table thead th {
            background: #f8fafc;
            color: #667085;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            padding: 15px 12px;
            border-bottom: 1px solid #edf0f5;
            white-space: nowrap;
        }

        .dashboard-table tbody td {
            padding: 17px 12px;
            border-bottom: 1px solid #f0f2f6;
            font-size: 12px;
        }

        .dashboard-table tbody tr:last-child td {
            border-bottom: none;
        }

        .dashboard-table tbody tr:hover {
            background: #fafbff;
        }

        .ticket-number {
            font-weight: 700;
            color: #4263eb;
            font-size: 12px;
        }

        .ticket-title {
            font-weight: 600;
            color: #344054;
        }

        .ticket-date {
            color: #667085;
            font-size: 11px;
            white-space: nowrap;
        }

        .ticket-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 20px;
            padding: 6px 10px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .priority-high {
            background: #fff0ef;
            color: #d92d20;
        }

        .priority-medium {
            background: #fff6df;
            color: #b7791f;
        }

        .priority-low {
            background: #e9f8ef;
            color: #168653;
        }

        .priority-default {
            background: #f2f4f7;
            color: #667085;
        }

        .status-open {
            background: #eef4ff;
            color: #175cd3;
        }

        .status-progress {
            background: #fff6df;
            color: #b7791f;
        }

        .status-resolved {
            background: #e9f8ef;
            color: #168653;
        }

        .status-closed {
            background: #f2f4f7;
            color: #475467;
        }

        .status-default {
            background: #f2f4f7;
            color: #667085;
        }

        .badge-dot {
            width: 6px;
            height: 6px;
            background: currentColor;
            border-radius: 50%;
        }

        .ticket-view-btn {
            width: 32px;
            height: 32px;
            display: inline-grid;
            place-items: center;
            background: #eef2ff;
            color: #4263eb;
            border-radius: 8px;
            text-decoration: none;
            transition: all .2s;
        }

            .ticket-view-btn:hover {
                background: #4263eb;
                color: white;
            }

        .dashboard-empty-state {
            text-align: center;
            padding: 45px 15px;
        }

        .empty-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 13px;
            display: grid;
            place-items: center;
            background: #eef2ff;
            color: #4263eb;
            border-radius: 50%;
            font-size: 25px;
        }

        .dashboard-empty-state h6 {
            color: #344054;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .dashboard-empty-state p {
            color: #98a2b3;
            font-size: 11px;
            margin-bottom: 15px;
        }

        .dashboard-table-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            padding: 15px 24px;
            background: #fff;
            border-top: 1px solid #edf0f5;
            color: #98a2b3;
            font-size: 10px;
        }

            .dashboard-table-footer strong {
                color: #344054;
            }

            .dashboard-table-footer a {
                color: #4263eb;
                text-decoration: none;
                font-weight: 600;
            }

        @@media (max-width: 768px) {
            .dashboard-welcome h2 {
                font-size: 22px;
            }

            .dashboard-table-header {
                padding: 18px;
            }

            .dashboard-table-footer {
                padding: 13px 17px;
            }
        }
    </style>
}
