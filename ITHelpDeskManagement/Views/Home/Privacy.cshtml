@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container-fluid px-0">

    <!-- Page Heading -->
    <div class="mb-4">
        <h2 class="fw-bold">Privacy Policy</h2>
        <p class="text-muted">
            Learn how the IT Helpdesk Management System handles your information.
        </p>
    </div>

    <!-- Introduction -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">1. Introduction</h5>
            <p class="text-muted mb-0">
                The IT Helpdesk Management System helps users report IT-related
                problems and allows support staff to manage and resolve tickets.
                This page explains how information may be used within the system.
            </p>
        </div>
    </div>

    <!-- Information Collection -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">2. Information We Collect</h5>
            <p class="text-muted">
                Depending on the features you use, the system may store:
            </p>
            <ul class="text-muted mb-0">
                <li>Account information, such as email address.</li>
                <li>Ticket titles and problem descriptions.</li>
                <li>Ticket status, priority, and creation date.</li>
                <li>Information required to manage and resolve support requests.</li>
            </ul>
        </div>
    </div>

    <!-- Use of Information -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">3. How Information Is Used</h5>
            <ul class="text-muted mb-0">
                <li>To create and manage IT support tickets.</li>
                <li>To track ticket progress and resolution.</li>
                <li>To authenticate users and control access.</li>
                <li>To improve the support process and system functionality.</li>
            </ul>
        </div>
    </div>

    <!-- Security -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">4. Data Security</h5>
            <p class="text-muted mb-0">
                The application uses authentication and access-control features
                to help protect account and ticket information. Users should
                keep their passwords confidential and avoid including sensitive
                information in ticket descriptions.
            </p>
        </div>
    </div>

    <!-- User Responsibility -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">5. User Responsibilities</h5>
            <ul class="text-muted mb-0">
                <li>Provide accurate information when creating tickets.</li>
                <li>Keep login credentials secure.</li>
                <li>Use the system only for authorized support purposes.</li>
            </ul>
        </div>
    </div>

    <!-- Contact -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">6. Questions or Concerns</h5>
            <p class="text-muted mb-0">
                For questions about this application's privacy practices,
                contact the system administrator.
            </p>
        </div>
    </div>

    <div class="text-muted small mt-4">
        Last updated: October 2026
    </div>

</div>
