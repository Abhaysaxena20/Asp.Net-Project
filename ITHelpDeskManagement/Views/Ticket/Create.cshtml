@model ITHelpDeskManagement.Models.Ticket

@{
    ViewData["Title"] = "Raise a Ticket";
}

<div class="container mt-4">
    <h2>Raise an IT Support Ticket</h2>
    <p>Describe the technical issue you are facing.</p>

    <form asp-controller="Ticket" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control"
                   placeholder="e.g. Laptop is not connecting to Wi-Fi" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"
                      rows="5"
                      placeholder="Explain the issue in detail"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Submit Ticket
        </button>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
