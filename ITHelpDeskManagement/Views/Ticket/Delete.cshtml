@model ITHelpDeskManagement.Models.Ticket

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">Delete Ticket</h2>
        <p class="text-muted">
            Please confirm before permanently deleting this ticket.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white p-3">
            <h5 class="mb-0">Confirm Deletion</h5>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning">
                Are you sure you want to delete this ticket?
                This action cannot be undone.
            </div>

            <h5 class="fw-bold">@Model.Title</h5>

            <p class="text-muted">
                Ticket ID: #@Model.TicketId
            </p>

            <p>
                <strong>Status:</strong> @Model.Status
            </p>

            <p>
                <strong>Priority:</strong> @Model.Priority
            </p>

            <p>
                <strong>Description:</strong>
                <br />
                @Model.Description
            </p>

            <form asp-action="Delete"
                  asp-route-id="@Model.TicketId"
                  method="post">

                <input type="hidden" asp-for="TicketId" />

                <div class="d-flex gap-2 justify-content-end mt-4">

                    <a asp-action="Details"
                       asp-route-id="@Model.TicketId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-danger">
                        Delete Ticket
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>
