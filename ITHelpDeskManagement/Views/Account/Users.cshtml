@model IEnumerable<ITHelpDeskManagement.Models.ApplicationUser>

@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "Manage Users";

    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>
                    ?? new Dictionary<string, IList<string>>();

    var users = Model?.ToList() ?? new List<ITHelpDeskManagement.Models.ApplicationUser>();

    int totalUsers = users.Count;
    int adminCount = 0;
    int supportCount = 0;
    int employeeCount = 0;

    foreach (var user in users)
    {
        var roles = userRoles.ContainsKey(user.Id)
            ? userRoles[user.Id]
            : new List<string>();

        if (roles.Contains("Admin")) adminCount++;
        if (roles.Contains("SupportStaff")) supportCount++;
        if (roles.Contains("User")) employeeCount++;
    }
}

<style>
    .users-page {
        padding: 10px 5px 30px;
        color: #263247;
    }

    .users-heading {
        font-size: 27px;
        font-weight: 750;
        color: #202c40;
        margin-bottom: 5px;
    }

    .users-subtitle {
        color: #8490a3;
        font-size: 14px;
    }

    .users-stat-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 13px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 3px 12px rgba(20, 35, 60, .035);
    }

    .stat-label {
        color: #8290a5;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 9px;
    }

    .stat-number {
        color: #263247;
        font-size: 27px;
        font-weight: 750;
        margin: 0;
    }

    .stat-icon {
        width: 43px;
        height: 43px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .icon-blue {
        background: #eaf1ff;
        color: #4263eb;
    }

    .icon-green {
        background: #e7f8ef;
        color: #16a36a;
    }

    .icon-purple {
        background: #f0eaff;
        color: #805ad5;
    }

    .icon-orange {
        background: #fff2e5;
        color: #e58a28;
    }

    .users-panel {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 13px;
        box-shadow: 0 3px 12px rgba(20, 35, 60, .035);
        overflow: hidden;
    }

    .users-panel-header {
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f5;
    }

    .users-panel-title {
        font-size: 17px;
        font-weight: 700;
        margin: 0;
        color: #263247;
    }

    .users-toolbar {
        padding: 17px 22px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        border-bottom: 1px solid #edf0f5;
    }

    .users-search {
        flex: 1;
        min-width: 220px;
        max-width: 390px;
    }

        .users-search input,
        .users-filter {
            height: 40px;
            border: 1px solid #e1e6ee;
            border-radius: 8px;
            font-size: 13px;
            box-shadow: none !important;
        }

            .users-search input:focus,
            .users-filter:focus {
                border-color: #4263eb;
            }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

        .users-table thead th {
            background: #f8faff;
            color: #8793a6;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 15px 18px;
            border-bottom: 1px solid #edf0f5;
        }

        .users-table tbody td {
            padding: 16px 18px;
            border-bottom: 1px solid #f0f2f6;
            vertical-align: middle;
            font-size: 13px;
        }

        .users-table tbody tr:hover {
            background: #fafbff;
        }

    .user-avatar {
        width: 39px;
        height: 39px;
        border-radius: 50%;
        background: #eaf0ff;
        color: #4263eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
        font-size: 13px;
        flex-shrink: 0;
    }

    .user-name {
        color: #263247;
        font-weight: 650;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .user-email {
        color: #8994a6;
        font-size: 12px;
    }

    .role-badge {
        display: inline-block;
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 11px;
        font-weight: 650;
        margin: 2px 3px 2px 0;
    }

    .role-admin {
        background: #e8f8ef;
        color: #168653;
    }

    .role-user {
        background: #eaf1ff;
        color: #4263eb;
    }

    .role-support {
        background: #fff1e3;
        color: #c77b24;
    }

    .role-none {
        background: #f0f1f4;
        color: #747f91;
    }

    .action-form {
        display: inline-block;
        margin: 2px 3px 2px 0;
    }

    .action-btn {
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        padding: 7px 10px;
    }

    .users-footer {
        padding: 15px 22px;
        color: #8994a6;
        font-size: 12px;
    }

    .users-empty {
        padding: 45px 15px !important;
        text-align: center;
        color: #8994a6;
    }

    @@media (max-width: 768px) {
        .users-heading {
            font-size: 23px;
        }

        .users-panel-header {
            padding: 16px;
        }

        .users-toolbar {
            padding: 14px;
        }

        .users-table tbody td,
        .users-table thead th {
            padding: 13px;
        }
    }
</style>

<div class="users-page">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="users-heading">Manage Users</h2>
            <p class="users-subtitle mb-0">
                Manage user accounts, monitor roles and control access to your helpdesk system.
            </p>
        </div>

        <div>
            <span class="badge bg-light text-primary border px-3 py-2">
                <i class="bi bi-people me-1"></i>
                User Administration
            </span>
        </div>

    </div>

    <!-- SUCCESS / ERROR MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATISTICS CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="users-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Total Users</div>
                        <h3 class="stat-number">@totalUsers</h3>
                    </div>
                    <div class="stat-icon icon-blue">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="users-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Administrators</div>
                        <h3 class="stat-number">@adminCount</h3>
                    </div>
                    <div class="stat-icon icon-green">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="users-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Support Staff</div>
                        <h3 class="stat-number">@supportCount</h3>
                    </div>
                    <div class="stat-icon icon-purple">
                        <i class="bi bi-headset"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="users-stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Employees</div>
                        <h3 class="stat-number">@employeeCount</h3>
                    </div>
                    <div class="stat-icon icon-orange">
                        <i class="bi bi-person-badge"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- USERS TABLE PANEL -->
    <div class="users-panel">

        <div class="users-panel-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="users-panel-title">All Users</h5>
                <small class="text-muted">View and manage registered accounts</small>
            </div>

            <span class="badge bg-light text-dark border px-3 py-2">
                @totalUsers Registered
            </span>
        </div>

        <!-- SEARCH AND FILTER -->
        <div class="users-toolbar">

            <div class="users-search">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           id="userSearch"
                           class="form-control border-start-0"
                           placeholder="Search by name or email..." />
                </div>
            </div>

            <select id="roleFilter" class="form-select users-filter" style="max-width:200px;">
                <option value="all">All Roles</option>
                <option value="admin">Admin</option>
                <option value="supportstaff">Support Staff</option>
                <option value="user">Employee</option>
                <option value="none">No Role Assigned</option>
            </select>

        </div>

        <!-- TABLE -->
        <div class="table-responsive">

            <table class="users-table">

                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Account ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="usersTableBody">

                    @foreach (var user in users)
                    {
                        var roles = userRoles.TryGetValue(user.Id, out var assignedRoles)
                            ? assignedRoles
                            : new List<string>();

                        var displayName = string.IsNullOrWhiteSpace(user.FullName)
                            ? user.UserName ?? "Unknown User"
                            : user.FullName;

                        var initials = string.Join("",
                            displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(x => x.Substring(0, 1).ToUpper()));

                        var roleSearch = string.Join(" ", roles).ToLowerInvariant();

                        if (!roles.Any())
                        {
                            roleSearch = "none";
                        }

                        <tr class="user-row"
                            data-user="@($"{displayName} {user.Email}".ToLowerInvariant())"
                            data-role="@roleSearch">

                            <!-- USER DETAILS -->
                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    <div class="user-avatar">
                                        @(string.IsNullOrWhiteSpace(initials) ? "U" : initials)
                                    </div>

                                    <div>
                                        <div class="user-name">@displayName</div>
                                        <div class="user-email">@user.Email</div>
                                    </div>

                                </div>
                            </td>

                            <!-- USER ROLES -->
                            <td>

                                @if (roles.Contains("Admin"))
                                {
                                    <span class="role-badge role-admin">Admin</span>
                                }

                                @if (roles.Contains("User"))
                                {
                                    <span class="role-badge role-user">Employee</span>
                                }

                                @if (roles.Contains("SupportStaff"))
                                {
                                    <span class="role-badge role-support">Support Staff</span>
                                }

                                @if (!roles.Any())
                                {
                                    <span class="role-badge role-none">No Role Assigned</span>
                                }

                            </td>

                            <!-- ACCOUNT ID -->
                            <td>
                                <span class="text-muted" title="@user.Id">
                                    @user.Id.Substring(0, Math.Min(8, user.Id.Length))...
                                </span>
                            </td>

                            <!-- ACTIONS -->
                            <td>

                                @if (roles.Contains("Admin"))
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Already Admin
                                    </span>
                                }
                                else if (roles.Contains("User") &&
                                         roles.Contains("SupportStaff"))
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Employee + Support Staff
                                    </span>
                                }
                                else if (roles.Contains("SupportStaff"))
                                {
                                    <form asp-controller="Account"
                                          asp-action="MakeEmployeeAndSupportStaff"
                                          method="post"
                                          class="action-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@user.Id" />

                                        <button type="submit" class="btn btn-primary action-btn">
                                            <i class="bi bi-person-plus me-1"></i>
                                            Add Employee Role
                                        </button>

                                    </form>
                                }
                                else if (roles.Contains("User"))
                                {
                                    <form asp-controller="Account"
                                          asp-action="MakeMeAdmin"
                                          method="post"
                                          class="action-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="userId" value="@user.Id" />

                                        <button type="submit" class="btn btn-outline-primary action-btn">
                                            <i class="bi bi-shield-plus me-1"></i>
                                            Make Admin
                                        </button>

                                    </form>

                                    <form asp-controller="Account"
                                          asp-action="MakeSupportStaff"
                                          method="post"
                                          class="action-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="userId" value="@user.Id" />

                                        <button type="submit" class="btn btn-outline-info action-btn">
                                            <i class="bi bi-headset me-1"></i>
                                            Make Support Staff
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">No available action</span>
                                }

                            </td>

                        </tr>
                    }

                    <tr id="noUsersFound" style="display:none;">
                        <td colspan="4" class="users-empty">
                            <i class="bi bi-search fs-3 d-block mb-2"></i>
                            No users found matching your search.
                        </td>
                    </tr>

                    @if (!users.Any())
                    {
                        <tr>
                            <td colspan="4" class="users-empty">
                                <i class="bi bi-people fs-2 d-block mb-2"></i>
                                No registered users found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="users-footer">
            Showing <strong id="visibleUserCount">@totalUsers</strong>
            of <strong>@totalUsers</strong> users
        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("userSearch");
        const roleFilter = document.getElementById("roleFilter");
        const rows = document.querySelectorAll(".user-row");
        const noUsersFound = document.getElementById("noUsersFound");
        const visibleCount = document.getElementById("visibleUserCount");

        function filterUsers() {

            const searchText = searchInput.value.toLowerCase().trim();
            const selectedRole = roleFilter.value.toLowerCase();

            let visible = 0;

            rows.forEach(function (row) {

                const userText = row.dataset.user || "";
                const userRoles = (row.dataset.role || "").split(" ");

                const matchesSearch = userText.includes(searchText);

                const matchesRole =
                    selectedRole === "all" ||
                    userRoles.includes(selectedRole);

                const shouldShow = matchesSearch && matchesRole;

                row.style.display = shouldShow ? "" : "none";

                if (shouldShow) {
                    visible++;
                }

            });

            noUsersFound.style.display =
                visible === 0 && rows.length > 0 ? "" : "none";

            visibleCount.textContent = visible;
        }

        searchInput.addEventListener("input", filterUsers);
        roleFilter.addEventListener("change", filterUsers);

    });
</script>
